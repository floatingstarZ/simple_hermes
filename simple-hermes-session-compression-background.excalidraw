    {"id":"title","type":"text","x":60,"y":40,"width":1040,"height":34,"text":"Simple Hermes：长期会话、上下文压缩、后台任务","fontSize":28,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"Simple Hermes：长期会话、上下文压缩、后台任务","autoResize":true},
